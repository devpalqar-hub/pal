# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/pal"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Used by `npm run db:seed` to create the first SUPER_ADMIN
SEED_ADMIN_EMAIL="admin@pal.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Super Admin"

# Company mail server (IMAP for reading, SMTP for sending)
MAIL_HOST="mail.palqar.com"
MAIL_IMAP_PORT="993"
MAIL_SMTP_PORT="465"
# Key used to encrypt stored mailbox passwords (falls back to JWT_SECRET)
MAIL_SECRET_KEY="change-me-too"

# Optional: email copies of task/leave notifications (a mailbox on the same mail server)
NOTIFY_MAIL_USER=""
NOTIFY_MAIL_PASSWORD=""
# Public URL used in notification email links
APP_URL="http://localhost:3000"
