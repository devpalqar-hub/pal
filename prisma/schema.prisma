generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Hierarchy (high -> low): SUPER_ADMIN > COMPANY_HEAD > MANAGER > LEAD > STAFF
enum Role {
  SUPER_ADMIN
  COMPANY_HEAD
  MANAGER
  LEAD
  STAFF
}

enum AttendanceStatus {
  IN_PROGRESS
  PRESENT
  HALF_DAY
  ABSENT
}

enum WorkEventType {
  START
  PAUSE
  RESUME
  STOP
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  name            String
  password        String
  role            Role     @default(STAFF)
  /// Free-text title, e.g. CEO / CTO / CFO / Partner for COMPANY_HEAD
  designation     String?
  isActive        Boolean  @default(true)
  /// Company mailbox on the mail server (credentials stored encrypted)
  /// Send an email copy of in-app notifications
  notifyEmail     Boolean  @default(true)
  mailEmail       String?  @unique
  mailPasswordEnc String?  @db.Text
  createdById     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schedule       WorkSchedule?
  salaries       SalaryRecord[]
  roleChanges    RoleChange[]    @relation("RoleChangeTarget")
  leaveAddOns    LeaveAddOn[]    @relation("LeaveAddOnUser")
  attendanceDays AttendanceDay[]
  leaveRequests  LeaveRequest[]
  notifications  Notification[]
  ownedProjects  Project[]       @relation("ProjectOwner")
  memberships    ProjectMember[]
  createdTasks   Task[]          @relation("TaskCreator")
  assignedTasks  Task[]          @relation("TaskAssignee")
  reviewTasks    Task[]          @relation("TaskReviewer")
  taskEvents     TaskEvent[]

  @@map("users")
}

model RoleChange {
  id          Int      @id @default(autoincrement())
  userId      Int
  fromRole    Role?
  toRole      Role
  changedById Int
  note        String?
  createdAt   DateTime @default(now())

  user User @relation("RoleChangeTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("role_changes")
}

model WorkSchedule {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  /// "HH:mm" 24h, server local time
  startTime         String
  endTime           String
  /// 0=Sunday ... 6=Saturday
  workingDays       Json
  /// Minutes of work required for a full "PRESENT" day
  requiredMinutes   Int      @default(480)
  /// Minutes of work required for "HALF_DAY"
  halfDayMinutes    Int      @default(240)
  lateGraceMinutes  Int      @default(15)
  earlyGraceMinutes Int      @default(15)
  paidLeavesPerYear Int      @default(12)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("work_schedules")
}

/// Salary history. The current salary is the latest record with effectiveFrom <= today.
/// An increment is simply a new record.
model SalaryRecord {
  id            Int      @id @default(autoincrement())
  userId        Int
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR")
  effectiveFrom DateTime @db.Date
  reason        String?
  createdById   Int
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom])
  @@map("salary_records")
}

/// Extra paid leave granted on top of the schedule's yearly entitlement.
model LeaveAddOn {
  id          Int      @id @default(autoincrement())
  userId      Int
  year        Int
  days        Float
  reason      String?
  grantedById Int
  createdAt   DateTime @default(now())

  user User @relation("LeaveAddOnUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, year])
  @@map("leave_add_ons")
}

model AttendanceDay {
  id                Int              @id @default(autoincrement())
  userId            Int
  date              DateTime         @db.Date
  firstStartAt      DateTime?
  lastStopAt        DateTime?
  totalWorkMinutes  Int              @default(0)
  totalBreakMinutes Int              @default(0)
  status            AttendanceStatus @default(IN_PROGRESS)
  isLate            Boolean          @default(false)
  lateMinutes       Int              @default(0)
  isEarlyCheckout   Boolean          @default(false)
  earlyMinutes      Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events WorkEvent[]

  @@unique([userId, date])
  @@map("attendance_days")
}

model WorkEvent {
  id           Int           @id @default(autoincrement())
  attendanceId Int
  type         WorkEventType
  at           DateTime      @default(now())

  attendance AttendanceDay @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId, at])
  @@map("work_events")
}

// ───────────────────────── Projects & tasks ─────────────────────────

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectRole {
  OWNER
  MEMBER
}

/// TODO -> IN_PROGRESS <-> PAUSED -> COMPLETED -> (IN_REVIEW ->) ENDED. See docs/WORKFLOW.md
enum TaskStatus {
  TODO
  IN_PROGRESS
  PAUSED
  COMPLETED
  IN_REVIEW
  ENDED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskEventType {
  CREATED
  ASSIGNED
  STARTED
  PAUSED
  RESUMED
  COMPLETED
  REVIEW_REQUESTED
  APPROVED
  REJECTED
  ENDED
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @db.Date
  dueDate     DateTime?     @db.Date
  ownerId     Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members ProjectMember[]
  tasks   Task[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        Int         @id @default(autoincrement())
  projectId Int
  userId    Int
  role      ProjectRole @default(MEMBER)
  addedById Int
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id               Int          @id @default(autoincrement())
  projectId        Int
  /// Parent task: a task can be broken into many sub-tasks.
  parentId         Int?
  title            String
  description      String?      @db.Text
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(TODO)
  estimatedMinutes Int?
  dueDate          DateTime?    @db.Date
  createdById      Int
  assigneeId       Int?
  reviewerId       Int?
  /// Accumulated tracked time (finished intervals)
  workedSeconds    Int          @default(0)
  /// Set while the timer is running (status IN_PROGRESS)
  lastResumedAt    DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  endedAt          DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Task?       @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]      @relation("SubTasks")
  creator  User        @relation("TaskCreator", fields: [createdById], references: [id])
  assignee User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reviewer User?       @relation("TaskReviewer", fields: [reviewerId], references: [id])
  events   TaskEvent[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([parentId])
  @@map("tasks")
}

model TaskEvent {
  id      Int           @id @default(autoincrement())
  taskId  Int
  type    TaskEventType
  actorId Int
  note    String?
  at      DateTime      @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId, at])
  @@map("task_events")
}

// ───────────────────────── Leave requests ─────────────────────────

enum LeaveType {
  PAID
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           Int         @id @default(autoincrement())
  userId       Int
  type         LeaveType   @default(PAID)
  status       LeaveStatus @default(PENDING)
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  /// Working days covered (0.5 for a half day)
  days         Float
  halfDay      Boolean     @default(false)
  reason       String?
  decidedById  Int?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("leave_requests")
}

// ───────────────────────── Notifications ─────────────────────────

enum NotificationType {
  TASK_ASSIGNED
  TASK_REVIEW_REQUESTED
  TASK_COMPLETED
  TASK_APPROVED
  TASK_REJECTED
  TASK_ENDED
  LEAVE_DECIDED
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  body      String?          @db.Text
  link      String?
  taskId    Int?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, taskId])
  @@map("notifications")
}
